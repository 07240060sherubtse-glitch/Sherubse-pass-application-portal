{
  "name": "sherubtse-pass-application-portal",
  "version": "2.0.0",
  "description": "Sherubtse College leave and pass application portal using Express and PostgreSQL",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "db:create": "node scripts/create-database.js",
    "db:schema": "node scripts/init-schema.js",
    "db:setup": "npm run db:create && npm run db:schema",
    "db:seed-staff": "node scripts/seed-staff.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^7.0.13",
    "pg-promise": "^12.7.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
